---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import PostListItem from '../components/PostListItem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { sortPostsNewestFirst } from '../lib/content';
import { sortPostsRecentlyUpdated } from '../lib/recent-updates';
const posts = sortPostsNewestFirst((await getCollection('blog')).filter((post) => !post.data.draft));
const featured = posts.filter((post) => post.data.featured).slice(0, 2);
const latest = sortPostsRecentlyUpdated(posts).slice(0, 4);
---
<BaseLayout>
  <section class="hero" data-hero>
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Personal log / Since 2026</p>
        <h1 class="display-title" data-hero-title>记录思考，<br />持续<em>构建</em>。</h1>
      </div>
      <aside class="hero-aside">
        <span class="hero-index">00 / INTRO</span>
        <p class="lead">{SITE.tagline}。在清晰与克制之间，保存真实的实践和想法。</p>
      </aside>
    </div>
  </section>
  {featured.length > 0 && <section class="section">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Selected notes</p><h2 class="section-title">精选文章</h2></div><a class="text-link" href="/posts/">浏览全部 →</a></div>
      <div class="post-grid">{featured.map((post) => <PostCard post={post} headingLevel={3} tagLimit={1} />)}</div>
    </div>
  </section>}
  <section class="section home-latest">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Latest writing</p><h2 class="section-title">最近更新</h2></div>
        <a class="text-link" href="/posts/">浏览全部 →</a>
      </div>
      <ol class="post-list post-list--compact">
        {latest.map((post) => <PostListItem post={post} />)}
      </ol>
    </div>
  </section>
</BaseLayout>
