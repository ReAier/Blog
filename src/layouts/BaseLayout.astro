---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CodeEnhancer from '../components/CodeEnhancer.astro';
import MotionShell from '../components/MotionShell.astro';
import { resolvePageKind } from '../lib/motion';
import { BACKGROUND_PRESETS, DEFAULT_BACKGROUND } from '../lib/preferences';
interface Props { title?: string; description?: string; image?: string; article?: boolean; robots?: string; }
const props = Astro.props;
const pageKind = props.article ? 'article' : resolvePageKind(Astro.url.pathname);
const backgroundNames = BACKGROUND_PRESETS.map((background) => background.name);
---
<html lang="zh-CN" data-theme="light" data-accent="rose" data-background="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f1eb" />
    <script is:inline define:vars={{ backgroundNames, defaultBackground: DEFAULT_BACKGROUND }}>
      (() => {
        const allowed = new Set(['coral','teal','indigo','amber','rose']);
        const savedTheme = localStorage.getItem('aier-theme') || 'system';
        const savedAccent = localStorage.getItem('aier-accent-v2') || 'rose';
        const savedBackground = localStorage.getItem('aier-background-v1') || defaultBackground;
        const theme = savedTheme === 'dark' || savedTheme === 'light'
          ? savedTheme
          : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themeChoice = savedTheme;
        document.documentElement.dataset.accent = allowed.has(savedAccent) ? savedAccent : 'rose';
        document.documentElement.dataset.background = backgroundNames.includes(savedBackground) ? savedBackground : defaultBackground;
      })();
    </script>
    <SeoHead {...props} />
    <ClientRouter />
  </head>
  <body data-page-kind={pageKind}>
    <MotionShell pageKind={pageKind} />
    <a class="skip-link" href="#main-content">跳至正文</a>
    <SiteHeader />
    <main id="main-content" class="site-main"><slot /></main>
    <SiteFooter />
    <CodeEnhancer />
    <script>
      import '../scripts/clip-copy';
    </script>
  </body>
</html>
