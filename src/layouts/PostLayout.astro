---
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { estimateReadingMinutes } from '../lib/content';
import { resolveCoverUrl } from '../lib/image-paths';
interface Entry { data: { title: string; description: string; publishedAt: Date; updatedAt?: Date; tags: string[]; cover?: string }; body?: string; }
interface Heading { depth: number; slug: string; text: string; }
const { entry, headings = [] } = Astro.props as { entry: Entry; headings: Heading[] };
const minutes = estimateReadingMinutes(entry.body ?? '');
const cover = resolveCoverUrl(entry.data.cover);
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={cover} article>
  <article>
    <header class="article-header reading-container">
      <p class="eyebrow">Article / Writing</p>
      <h1 class="article-title">{entry.data.title}</h1>
      <p class="article-description">{entry.data.description}</p>
      <PostMeta publishedAt={entry.data.publishedAt} updatedAt={entry.data.updatedAt} readingMinutes={minutes} tags={entry.data.tags} />
    </header>
    <div class="article-layout container">
      <div class="prose"><slot /></div>
      <aside class="article-aside"><TableOfContents headings={headings} /></aside>
    </div>
    <footer class="reading-container article-footer">
      <ul class="tag-list">{entry.data.tags.map((tag) => <li><a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>)}</ul>
      <a class="text-link" href="/posts/">← 返回文章列表</a>
    </footer>
  </article>
</BaseLayout>
