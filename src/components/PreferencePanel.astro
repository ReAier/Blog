---
import { BACKGROUND_PRESETS, DEFAULT_BACKGROUND } from '../lib/preferences';
---
<div class="preference-wrap">
  <button class="icon-button" type="button" data-preference-trigger aria-label="打开外观设置" aria-expanded="false" aria-controls="preference-panel">◐</button>
  <div id="preference-panel" class="preference-panel glass" data-preference-panel data-open="false" aria-label="外观设置">
    <h2 class="preference-title">外观设置</h2>
    <span class="preference-label">主题</span>
    <div class="choice-row" role="group" aria-label="主题模式">
      <button class="choice-button" type="button" data-theme-choice="system" aria-pressed="true">跟随系统</button>
      <button class="choice-button" type="button" data-theme-choice="light" aria-pressed="false">浅色</button>
      <button class="choice-button" type="button" data-theme-choice="dark" aria-pressed="false">深色</button>
    </div>
    <span class="preference-label">强调色</span>
    <div class="choice-row" role="group" aria-label="强调色">
      <button class="accent-choice" type="button" data-accent="coral" aria-label="橙红" aria-pressed="false" style="--swatch:#F05A3C"></button>
      <button class="accent-choice" type="button" data-accent="teal" aria-label="青绿" aria-pressed="false" style="--swatch:#16A085"></button>
      <button class="accent-choice" type="button" data-accent="indigo" aria-label="靛蓝" aria-pressed="false" style="--swatch:#4F6BED"></button>
      <button class="accent-choice" type="button" data-accent="amber" aria-label="琥珀" aria-pressed="false" style="--swatch:#D89016"></button>
      <button class="accent-choice" type="button" data-accent="rose" aria-label="玫红" aria-pressed="true" style="--swatch:#C74776"></button>
    </div>
    <span class="preference-label">背景</span>
    <div class="background-choice-row" role="group" aria-label="背景样式">
      {BACKGROUND_PRESETS.map((background) => (
        <button
          class="background-choice"
          type="button"
          data-background-choice={background.name}
          data-background-kind={background.kind}
          aria-label={background.label}
          aria-pressed={background.name === DEFAULT_BACKGROUND}
          style={background.kind === 'image'
            ? `--background-thumbnail-light: url('${background.src}'); --background-thumbnail-dark: url('${background.src}')`
            : `--background-thumbnail-light: linear-gradient(${background.lightColor}, ${background.lightColor}); --background-thumbnail-dark: linear-gradient(${background.darkColor}, ${background.darkColor})`
          }
        >
        </button>
      ))}
    </div>
  </div>
</div>
<script>
  import { BACKGROUND_PRESETS, DEFAULT_BACKGROUND, isBackground } from '../lib/preferences';

  const allowedAccents = new Set(['coral', 'teal', 'indigo', 'amber', 'rose']);
  const allowedBackgrounds = new Set(BACKGROUND_PRESETS.map((background) => background.name));
  let cleanupPreferences = () => {};

  function initializePreferences() {
    cleanupPreferences();
    const controller = new AbortController();
    const { signal } = controller;
    const root = document.documentElement;
    const trigger = document.querySelector<HTMLButtonElement>('[data-preference-trigger]');
    const panel = document.querySelector<HTMLElement>('[data-preference-panel]');
    const themeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
    const accentButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-accent]')];
    const backgroundButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-background-choice]')];
    const colorScheme = matchMedia('(prefers-color-scheme: dark)');

    const notify = () => {
      window.dispatchEvent(new CustomEvent('aier:preference-change', {
        detail: {
          theme: root.dataset.theme,
          accent: root.dataset.accent,
          background: root.dataset.background,
        },
      }));
    };
    const applyTheme = (choice: string, announce = true) => {
      const safeChoice = choice === 'dark' || choice === 'light' || choice === 'system' ? choice : 'system';
      const resolved = safeChoice === 'dark' || safeChoice === 'light'
        ? safeChoice
        : colorScheme.matches ? 'dark' : 'light';
      root.dataset.theme = resolved;
      root.dataset.themeChoice = safeChoice;
      themeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === safeChoice)));
      if (announce) notify();
    };
    const applyAccent = (accent: string, announce = true) => {
      const safeAccent = allowedAccents.has(accent) ? accent : 'rose';
      root.dataset.accent = safeAccent;
      accentButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.accent === safeAccent)));
      if (announce) notify();
    };
    const applyBackground = (background: string, announce = true) => {
      const safeBackground = isBackground(background) && allowedBackgrounds.has(background)
        ? background
        : DEFAULT_BACKGROUND;
      root.dataset.background = safeBackground;
      backgroundButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.backgroundChoice === safeBackground)));
      if (announce) notify();
    };
    const closePanel = (restoreFocus = false) => {
      if (panel) panel.dataset.open = 'false';
      trigger?.setAttribute('aria-expanded', 'false');
      if (restoreFocus) trigger?.focus();
    };

    applyTheme(localStorage.getItem('aier-theme') || 'system', false);
    applyAccent(localStorage.getItem('aier-accent-v2') || 'rose', false);
    applyBackground(localStorage.getItem('aier-background-v1') || DEFAULT_BACKGROUND, false);
    notify();

    trigger?.addEventListener('click', () => {
      const open = panel?.dataset.open !== 'true';
      if (panel) panel.dataset.open = String(open);
      trigger.setAttribute('aria-expanded', String(open));
    }, { signal });

    themeButtons.forEach((button) => button.addEventListener('click', () => {
      const choice = button.dataset.themeChoice || 'system';
      localStorage.setItem('aier-theme', choice);
      applyTheme(choice);
    }, { signal }));

    accentButtons.forEach((button) => button.addEventListener('click', () => {
      const accent = button.dataset.accent || 'rose';
      localStorage.setItem('aier-accent-v2', accent);
      applyAccent(accent);
    }, { signal }));

    backgroundButtons.forEach((button) => button.addEventListener('click', () => {
      const background = button.dataset.backgroundChoice || DEFAULT_BACKGROUND;
      localStorage.setItem('aier-background-v1', background);
      applyBackground(background);
    }, { signal }));

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Node ? event.target : null;
      if (target && panel?.dataset.open === 'true' && !panel.contains(target) && !trigger?.contains(target)) closePanel();
    }, { signal });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel?.dataset.open === 'true') closePanel(true);
    }, { signal });

    document.addEventListener('astro:before-preparation', () => closePanel(), { signal });
    colorScheme.addEventListener('change', () => {
      if ((localStorage.getItem('aier-theme') || 'system') === 'system') applyTheme('system');
    }, { signal });

    cleanupPreferences = () => controller.abort();
  }

  document.addEventListener('astro:page-load', initializePreferences);
  initializePreferences();
</script>
