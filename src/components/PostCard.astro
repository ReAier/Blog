---
import PostMeta from './PostMeta.astro';
interface Props { post: { id: string; data: { title: string; description: string; publishedAt: Date; updatedAt?: Date; tags: string[] } }; index?: number; }
const { post, index = 0 } = Astro.props;
const revealDelay = Math.min(index * 70, 210);
---
<article class="post-card" data-motion-card data-reveal style={`--reveal-delay: ${revealDelay}ms`}>
  <PostMeta publishedAt={post.data.publishedAt} updatedAt={post.data.updatedAt} tags={post.data.tags} />
  <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
</article>
