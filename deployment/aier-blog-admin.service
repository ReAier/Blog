[Unit]
Description=Aier Blog single-user administration service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aier-blog
Group=aier-blog
WorkingDirectory=/opt/aier-blog/current
Environment=NODE_ENV=production
Environment=BLOG_CONTENT_ROOT=/var/lib/aier-blog/content
Environment=BLOG_ADMIN_DATA_ROOT=/var/lib/aier-blog
Environment=ADMIN_HOST=127.0.0.1
Environment=ADMIN_PORT=4310
Environment=ADMIN_PUBLIC_ORIGIN=https://admin.blog.reaier.top
Environment=BLOG_SITE_ORIGIN=https://blog.reaier.top
Environment=BLOG_PUBLISH_REQUEST_ROOT=/var/lib/aier-blog/publish-requests
EnvironmentFile=/etc/aier-blog/admin.env
ExecStart=/usr/local/bin/node --import tsx admin/server/index.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/aier-blog
UMask=0077

[Install]
WantedBy=multi-user.target
